@model Customer
@{
    ViewData["Title"] = "Customer Details";
}
<div class="card shadow-sm">
    <div class="card-header bg-white"><h5 class="mb-0">Customer Details</h5></div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Name)</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Email)</dt>
            <dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Phone)</dt>
            <dd class="col-sm-9">@Model.Phone</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.City)</dt>
            <dd class="col-sm-9">@(Model.City ?? "-")</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Address)</dt>
            <dd class="col-sm-9">@(Model.Address ?? "-")</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? "Active" : "Inactive")</span>
            </dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CreatedOn)</dt>
            <dd class="col-sm-9">@Model.CreatedOn.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.UpdatedOn)</dt>
            <dd class="col-sm-9">@(Model.UpdatedOn?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") ?? "-")</dd>
        </dl>
    </div>
    <div class="card-footer bg-white text-end">
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
    </div>
</div>
