@{
    ViewData["Title"] = "Home";
}
<div class="text-center py-5">
    <h1 class="display-5 mb-3"><i class="bi bi-people-fill me-2 text-primary"></i>Customer Portal</h1>
    <p class="lead text-muted mb-4">Manage your customers in one place.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Customers" asp-action="Index" class="btn btn-primary btn-lg">
            <i class="bi bi-list-ul me-1"></i>View Customers
        </a>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg">
            <i class="bi bi-box-arrow-in-right me-1"></i>Login
        </a>
    }
</div>
