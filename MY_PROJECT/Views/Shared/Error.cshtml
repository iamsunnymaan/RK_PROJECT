@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="text-center py-5">
    <h1 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Something went wrong</h1>
    <p class="text-muted">An error occurred while processing your request.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Customers" asp-action="Index">Back to customers</a>
</div>
